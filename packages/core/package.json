{
  "name": "@antfabric/ui-core",
  "version": "1.2.0",
  "type": "module",
  "description": "What both kits share: the design tokens, the themes (defineTheme, themes), the CSS variables and React Native values they produce, shortcut formatting, the entrance motions and, from /chart, the formatters and scales behind every chart.",
  "license": "MIT",
  "author": "GeekyAnts",
  "homepage": "https://github.com/AntFabric/antfabric-ui#readme",
  "bugs": {
    "url": "https://github.com/AntFabric/antfabric-ui/issues"
  },
  "keywords": [
    "antfabric",
    "design-tokens",
    "themes",
    "react",
    "react-native"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntFabric/antfabric-ui.git",
    "directory": "packages/core"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./dtcg": "./src/dtcg.ts",
    "./chart": "./src/chart/index.ts",
    "./antfabric": "./src/antfabric.ts",
    "./tokens.json": "./tokens.json",
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*",
    "./renames.json": "./renames.json"
  },
  "bin": {
    "af-tokens-codemod": "./codemod/rename-tokens.mjs"
  },
  "files": [
    "dist",
    "tokens.json",
    "fonts/fonts.css",
    "fonts/Figtree-*",
    "fonts/Geist-*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "codemod",
    "renames.json"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./dtcg": {
        "types": "./dist/dtcg.d.ts",
        "import": "./dist/dtcg.js",
        "default": "./dist/dtcg.js"
      },
      "./chart": {
        "types": "./dist/chart/index.d.ts",
        "import": "./dist/chart/index.js",
        "default": "./dist/chart/index.js"
      },
      "./antfabric": {
        "types": "./dist/antfabric.d.ts",
        "import": "./dist/antfabric.js",
        "default": "./dist/antfabric.js"
      },
      "./tokens.json": "./tokens.json",
      "./fonts.css": "./fonts/fonts.css",
      "./fonts/*": "./fonts/*",
      "./renames.json": "./renames.json"
    }
  },
  "peerDependencies": {
    "react": ">=19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "react": "19.1.10",
    "typescript": "5.9.3"
  }
}

{
  "$description": "How AntFabric UI's design tokens are named. Generated by `pnpm tokens:build` from packages/core/src/naming.ts and token-registry.ts; `pnpm check names` holds every token to it.",
  "grammar": {
    "semantic": "category.property.role",
    "component": "componentId.partPropertyVariant",
    "cssVariable": "--af- + the path in kebab case",
    "figmaVariable": "the path with / for ."
  },
  "tiers": {
    "primitive": "A raw value mirrored from the product (`primitives.color.coral.500`). No component reads one.",
    "semantic": "A role any component may read, named category first (`color.text.muted`).",
    "component": "A value owned by the components its group names (`chip.removeSize`). An alias of a semantic token wherever the role is the same."
  },
  "categories": {
    "color": {
      "is": "A colour, by what it paints.",
      "properties": {
        "text": "Text and icons.",
        "background": "Fills and surfaces.",
        "border": "Edges, dividers and focus rings."
      }
    },
    "font": {
      "is": "Type.",
      "properties": {
        "family": "A font family.",
        "size": "A font size.",
        "lineHeight": "The line height that goes with the size of the same name.",
        "weight": "A font weight.",
        "letterSpacing": "Letter spacing, in em.",
        "file": "The file the phone loads for a face and a weight."
      }
    },
    "size": {
      "is": "The size of a thing: a height, a width or a side.",
      "properties": {
        "control": "A control's height.",
        "icon": "An icon's side.",
        "stroke": "An icon's line weight.",
        "dot": "A status dot's diameter.",
        "row": "A list row's height.",
        "avatar": "An avatar's side.",
        "target": "The least a pointer or touch target is.",
        "layout": "The app frame: rails, bars and insets."
      }
    },
    "space": {
      "is": "Padding, gaps and margins: one scale, and the gutters under `space.gutter`.",
      "properties": null
    },
    "radius": {
      "is": "A corner radius, named for the thing that wears it.",
      "properties": null
    },
    "border": {
      "is": "A border's width. Its colour is `color.border.*`.",
      "properties": {
        "width": "A border's width."
      }
    },
    "motion": {
      "is": "How things move.",
      "properties": {
        "duration": "How long.",
        "easing": "The curve."
      }
    },
    "elevation": {
      "is": "Lift off the surface.",
      "properties": {
        "shadow": "A shadow."
      }
    },
    "zIndex": {
      "is": "Stacking order.",
      "properties": null
    },
    "opacity": {
      "is": "A fade applied to a whole element.",
      "properties": null
    },
    "effect": {
      "is": "A material's filter values.",
      "properties": {
        "glass": "Liquid Glass: blur and saturation."
      }
    }
  },
  "componentProperties": {
    "Height": "A height.",
    "Width": "A width.",
    "MinHeight": "The least height.",
    "MaxHeight": "The most height.",
    "MinWidth": "The least width.",
    "MaxWidth": "The most width.",
    "Size": "A side or a diameter, where width and height are one.",
    "Radius": "A corner radius.",
    "Gap": "The space between two things.",
    "Padding": "Padding on every side.",
    "PaddingX": "Padding at both sides.",
    "PaddingY": "Padding above and below.",
    "PaddingLeft": "Padding at the start.",
    "PaddingTop": "Padding above.",
    "Inset": "How far in from an edge.",
    "OffsetX": "A sideways shift (negative hangs outside).",
    "OffsetY": "A vertical shift (negative hangs outside).",
    "Offset": "A shift on both axes.",
    "Overhang": "How far past an edge.",
    "FontSize": "A font size.",
    "LineHeight": "A line height.",
    "Color": "A colour.",
    "Shadow": "A shadow.",
    "FontFamily": "A font family.",
    "FontFile": "The phone's font file.",
    "Dash": "The length of a dash.",
    "Travel": "How far a part slides.",
    "Breakpoint": "The width at which the layout changes."
  },
  "sizes": [
    "xxs",
    "xs",
    "sm",
    "md",
    "lg",
    "xl",
    "2xs",
    "3xs",
    "2xl",
    "3xl",
    "4xl",
    "5xl"
  ],
  "states": {
    "hover": "Under the pointer.",
    "pressed": "Held down.",
    "focus": "Has keyboard focus.",
    "selected": "The current or chosen one.",
    "disabled": "Cannot be used."
  },
  "emphasis": {
    "subtle": "Quietest.",
    "muted": "Quiet.",
    "default": "The usual one: no word is also the default.",
    "strong": "Loudest."
  },
  "glossary": {
    "color.background": "Called surface in some systems: a fill something sits on.",
    "color.text": "Called foreground (fg): text and icons.",
    "soft": "A pale wash of a colour, for a tinted surface. Text on it is `on<Colour>Soft`.",
    "on<Fill>": "The text and icon colour that reads on that fill: `color.text.onBrand` on `color.background.brand.default`.",
    "lineHeight": "Called leading.",
    "letterSpacing": "Called tracking.",
    "scrim": "The dim layer behind a modal: a backdrop.",
    "target": "The area a pointer or a finger can hit, which may be larger than what is drawn.",
    "gutter": "The space between panes and around a page."
  },
  "modes": {
    "scheme": [
      "light",
      "dark"
    ],
    "profile": [
      "web",
      "desktop",
      "mobile"
    ],
    "os": [
      "android"

{
  "name": "@antfabric/ui-react",
  "version": "1.1.0",
  "type": "module",
  "description": "A generic, themeable component kit for React: the web and the desktop (Tauri). Inline styles over the token variables.",
  "license": "MIT",
  "author": "GeekyAnts",
  "homepage": "https://github.com/AntFabric/antfabric-ui#readme",
  "bugs": {
    "url": "https://github.com/AntFabric/antfabric-ui/issues"
  },
  "keywords": [
    "antfabric",
    "react",
    "components",
    "ui-kit",
    "design-system",
    "tauri"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntFabric/antfabric-ui.git",
    "directory": "packages/react"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./data": "./src/data/index.ts",
    "./shell": "./src/shell/index.ts",
    "./chat": "./src/chat/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./data": {
        "types": "./dist/data/index.d.ts",
        "import": "./dist/data/index.js",
        "default": "./dist/data/index.js"
      },
      "./shell": {
        "types": "./dist/shell/index.d.ts",
        "import": "./dist/shell/index.js",
        "default": "./dist/shell/index.js"
      },
      "./chat": {
        "types": "./dist/chat/index.d.ts",
        "import": "./dist/chat/index.js",
        "default": "./dist/chat/index.js"
      }
    }
  },
  "dependencies": {
    "@antfabric/ui-core": "workspace:^",
    "recharts": "3.10.1"
  },
  "peerDependencies": {
    "react": ">=19.1.0",
    "react-dom": ">=19.1.0",
    "lucide-react": ">=1.8.0"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "5.9.3",
    "lucide-react": "1.50.0"
  }
}

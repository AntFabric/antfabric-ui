/**
 * The 1.0 codemod's tests, run with `pnpm migrate:1:test`:
 *
 * 1. fixtures: `fixtures/before/*.tsx` migrated as one repository (kits imported directly) and `fixtures/before/wrapper/` migrated as a
 *    repository with a wrapper package (`--via @acme/ui-kit --wrapper libs/ui-kit/src`) must equal `fixtures/after/…`, and print the
 *    summary and manual list in `fixtures/expected/*.txt`;
 * 2. idempotence: migrating `after` again changes nothing;
 * 3. the tables against the packages and the docs: a rename's target is a documented prop and its source is not, the `/shell` and `/chat`
 *    lists are the entries' real exports, a renamed type is exported and a removed name is not;
 * 4. coverage: every automatic row of the tables fires somewhere in the fixtures.
 *
 *   --update           write `fixtures/after` and `fixtures/expected` from what the codemod does now (read the diff before committing it)
 *   --generate-sweep   rewrite `fixtures/before/sweep-react.tsx` and `sweep-native.tsx`, one line per automatic table row
 */
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawnSync } from "node:child_process";
import ts from "typescript";
import { migrate, report, type Result } from "./engine.mts";
import * as T from "./renames.ts";

const here = import.meta.dirname;
const root = path.resolve(here, "../..");
const FIX = path.join(here, "fixtures");
const UPDATE = process.argv.includes("--update");
const SWEEP = process.argv.includes("--generate-sweep");

const failures: string[] = [];
const fail = (m: string) => failures.push(m);
let checks = 0;
const check = (ok: boolean, m: string) => {
  checks++;
  if (!ok) fail(m);
};

// ---------------------------------------------------------------------------------------------------------------------
// the sweep: one line per automatic row, so no row goes untested
// ---------------------------------------------------------------------------------------------------------------------

function kebab(name: string) {
  return name.replace(/([a-z0-9])([A-Z])/g, "$1-$2").toLowerCase();
}

function sweepSources(): Record<T.Kit, string> {
  const byKit: Record<T.Kit, Map<string, string[]>> = { react: new Map(), native: new Map() };
  const lines: Record<T.Kit, string[]> = { react: [], native: [] };
  const use = (kit: T.Kit, comp: string, jsx: string) => {
    if (!byKit[kit].has(comp)) byKit[kit].set(comp, []);
    lines[kit].push(jsx);
  };
  const kitOf = (rule: { kit?: T.Kit; components: string[] }, comp: string): T.Kit => rule.kit ?? (comp === "MobileHeader" || comp === "TabBar" ? "native" : "react");
  const attr = (name: string, value: string) => (value === "" ? name : `${name}=${value}`);
  for (const r of T.propRenames) {
    for (const c of r.components) {
      const kit = kitOf(r, c);
      let v = "{flag}";
      if (r.handler === "ifReadsArg") v = "{(next) => next}";
      else if (r.handler === "invertedArg") v = "{() => undefined}";
      else if (/^on[A-Z]/.test(r.from)) v = "{() => undefined}";
      use(kit, c, `<${c} ${attr(r.from, v)} />`);
    }
  }
  for (const r of T.booleanInversions) for (const c of r.components) use(kitOf(r, c), c, `<${c} ${r.from}={flag} />`);
  for (const r of T.valueRenames) for (const c of r.components) use(kitOf(r, c), c, `<${c} ${r.prop}="${r.from}" />`);
  for (const r of T.styleKeyRenames) for (const c of r.components) use(kitOf(r, c), c, `<${c} styles={{ ${r.from}: {} }} />`);
  for (const r of T.itemFieldRenames) {
    for (const c of r.components) {
      const nested = r.nested?.[0];
      const item = nested ? `{ ${r.from}: "a", ${nested}: [{ ${r.from}: "b" }] }` : `{ ${r.from}: "a" }`;
      use(kitOf(r, c), c, `<${c} ${r.prop}={[${item}]} />`);
    }
  }
  for (const r of T.contentToChildren) for (const c of r.components) use("react", c, `<${c} ${r.prop}={<p>${c}</p>} />`);

  // one file per kit: a name imported from both would be one binding
  const header = "/* Generated by `pnpm migrate:1:test --generate-sweep`: one line per automatic row of renames.ts. Do not edit by hand. */";
  const out = {} as Record<T.Kit, string>;
  for (const kit of ["react", "native"] as T.Kit[]) {
    const comps = [...byKit[kit].keys()].sort();
    const types = T.typeRenames.map((t) => t.from);
    const text = [header, `import { ${comps.join(", ")} } from "${T.PACKAGES[kit]}";`];
    if (kit === "react") text.push(`import type { ${types.join(", ")} } from "${T.PACKAGES[kit]}";`);
    text.push(`declare const flag: boolean;`, `export const sweep = (`, `  <>`, ...lines[kit].map((l) => `    ${l}`), `  </>`, `);`);
    if (kit === "react") text.push(`export type Types = [${types.join(", ")}];`);
    out[kit] = text.join("\n") + "\n";
  }
  return out;
}

if (SWEEP) {
  const sources = sweepSources();
  for (const kit of ["react", "native"] as T.Kit[]) fs.writeFileSync(path.join(FIX, `before/sweep-${kit}.tsx`), sources[kit]);
  console.log("wrote fixtures/before/sweep-react.tsx and sweep-native.tsx");
}


// ---------------------------------------------------------------------------------------------------------------------
// fixtures
// ---------------------------------------------------------------------------------------------------------------------

function copyTree(src: string, dst: string, onlyFiles = false) {
  fs.mkdirSync(dst, { recursive: true });
  for (const e of fs.readdirSync(src, { withFileTypes: true })) {
    const s = path.join(src, e.name);
    if (e.isDirectory()) {
      if (onlyFiles || e.name === "wrapper") continue;
      copyTree(s, path.join(dst, e.name));
    } else fs.copyFileSync(s, path.join(dst, e.name));
  }
}
function copyAll(src: string, dst: string) {
  fs.mkdirSync(dst, { recursive: true });
  for (const e of fs.readdirSync(src, { withFileTypes: true })) {
    const s = path.join(src, e.name);
    if (e.isDirectory()) copyAll(s, path.join(dst, e.name));
    else fs.copyFileSync(s, path.join(dst, e.name));
  }
}
function listFiles(dir: string, base = dir, out: string[] = []): string[] {
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) listFiles(p, base, out);
    else out.push(path.relative(base, p).split(path.sep).join("/"));
  }
  return out.sort();
}

interface Case {
  name: string;
  before: string;
  after: string;
  expected: string;
  copy: (dst: string) => void;
  opts: { via?: string; wrapper?: string };
}

const cases: Case[] = [
  { name: "direct", before: "before", after: "after", expected: "expected/direct.txt", copy: (dst) => copyTree(path.join(FIX, "before"), dst, true), opts: {} },
  { name: "wrapper", before: "before/wrapper", after: "after/wrapper", expected: "expected/wrapper.txt", copy: (dst) => copyAll(path.join(FIX, "before/wrapper"), dst), opts: { via: "@acme/ui-kit", wrapper: "libs/ui-kit/src" } },
];

function normalise(text: string, repo: string) {
  return text.split(repo).join("<repo>");
}

const results: Record<string, Result> = {};

for (const c of cases) {
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), `migrate-1-${c.name}-`));
  try {
    c.copy(tmp);
    const result = migrate({ repo: tmp, ...c.opts });
    results[c.name] = result;
    const changed = new Map(result.files.map((f) => [f.file, f.after]));
    const files = listFiles(tmp);
    const afterRoot = path.join(FIX, c.after);
    const text = normalise(report(result), result.repo);
    if (UPDATE) {
      for (const f of files) {
        const out = path.join(afterRoot, f);
        fs.mkdirSync(path.dirname(out), { recursive: true });
        fs.writeFileSync(out, changed.get(f) ?? fs.readFileSync(path.join(tmp, f), "utf8"));
      }
      fs.mkdirSync(path.dirname(path.join(FIX, c.expected)), { recursive: true });
      fs.writeFileSync(path.join(FIX, c.expected), text);
    } else {
      for (const f of files) {
        const want = path.join(afterRoot, f);
        if (!fs.existsSync(want)) {
          fail(`${c.name}: fixtures/${c.after}/${f} is missing (run with --update)`);
          continue;
        }
        const got = changed.get(f) ?? fs.readFileSync(path.join(tmp, f), "utf8");
        const wantText = fs.readFileSync(want, "utf8");
        check(got === wantText, `${c.name}: ${f} differs from fixtures/${c.after}/${f}\n${firstDifference(wantText, got)}`);
      }
      const expectedPath = path.join(FIX, c.expected);
      check(fs.existsSync(expectedPath) && fs.readFileSync(expectedPath, "utf8") === text, `${c.name}: the printed summary and manual list differ from fixtures/${c.expected}`);
    }

    // idempotence: what the codemod wrote is left as it is
    const again = fs.mkdtempSync(path.join(os.tmpdir(), `migrate-1-again-${c.name}-`));
    try {
      for (const f of files) {
        const out = path.join(again, f);
        fs.mkdirSync(path.dirname(out), { recursive: true });
        fs.writeFileSync(out, changed.get(f) ?? fs.readFileSync(path.join(tmp, f), "utf8"));
      }
      const second = migrate({ repo: again, ...c.opts });
      check(second.files.length === 0, `${c.name}: running the codemod on its own output changes ${second.files.map((f) => f.file).join(", ")}${second.files[0] ? "\n" + firstDifference(second.files[0].before, second.files[0].after) : ""}`);
    } finally {
      fs.rmSync(again, { recursive: true, force: true });
    }
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
  }
}

// the command line: a dry run writes nothing, --write writes exactly the fixtures' after
{
  const c = cases[1]!;
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "migrate-1-cli-"));
  try {
    c.copy(tmp);
    const cli = path.join(root, "scripts/migrate-1.mts");
    const args = [tmp, "--via", c.opts.via!, "--wrapper", c.opts.wrapper!];
    const run = (extra: string[]) => spawnSync(process.execPath, ["--import", "tsx", cli, ...args, ...extra], { cwd: root, encoding: "utf8" });
    const dry = run([]);
    check(dry.status === 0 && dry.stdout.includes("--- a/apps/web/app.tsx") && dry.stdout.includes("Dry run: nothing was written"), `cli: the dry run printed no diff (${dry.stderr.slice(0, 200)})`);
    const untouched = listFiles(tmp).every((f) => fs.readFileSync(path.join(tmp, f), "utf8") === fs.readFileSync(path.join(FIX, "before/wrapper", f), "utf8"));
    check(untouched, "cli: the dry run changed a file");
    const written = run(["--write", "--no-diff"]);
    check(written.status === 0 && !written.stdout.includes("--- a/"), `cli: --write --no-diff failed or printed a diff (${written.stderr.slice(0, 200)})`);
    for (const f of listFiles(tmp)) check(fs.readFileSync(path.join(tmp, f), "utf8") === fs.readFileSync(path.join(FIX, "after/wrapper", f), "utf8"), `cli: --write left ${f} different from fixtures/after/wrapper/${f}`);
    const noVia = spawnSync(process.execPath, ["--import", "tsx", cli, tmp, "--wrapper", "libs/ui-kit/src"], { cwd: root, encoding: "utf8" });
    check(noVia.status === 2, "cli: --wrapper without --via should be refused");
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
  }
}

function firstDifference(want: string, got: string): string {
  const a = want.split("\n"), b = got.split("\n");
  for (let i = 0; i < Math.max(a.length, b.length); i++) {
    if (a[i] !== b[i]) return `  line ${i + 1}\n    want: ${a[i] ?? "(end)"}\n    got:  ${b[i] ?? "(end)"}`;
  }
  return "";
}

// ---------------------------------------------------------------------------------------------------------------------
// the tables against the packages
// ---------------------------------------------------------------------------------------------------------------------

function realExports(): Record<string, Set<string>> {
  const entries: Record<string, string> = {
    react: "packages/react/src/index.ts",
    "react/data": "packages/react/src/data/index.ts",
    "react/shell": "packages/react/src/shell/index.ts",
    "react/chat": "packages/react/src/chat/index.ts",
    native: "packages/react-native/src/index.ts",
    "native/data": "packages/react-native/src/data/index.ts",
    "native/shell": "packages/react-native/src/shell/index.ts",
    "native/chat": "packages/react-native/src/chat/index.ts",
    core: "packages/core/src/index.ts",
  };
  const files = Object.entries(entries).map(([k, v]) => [k, path.join(root, v)] as const);
  const program = ts.createProgram(files.map(([, f]) => f), {
    noEmit: true, jsx: ts.JsxEmit.Preserve, moduleResolution: ts.ModuleResolutionKind.Bundler, module: ts.ModuleKind.ESNext, target: ts.ScriptTarget.ESNext,
    skipLibCheck: true, allowImportingTsExtensions: true, baseUrl: root, types: [],
    paths: { "@antfabric-ui/core": [path.join(root, "packages/core/src/index.ts")], "@antfabric-ui/core/*": [path.join(root, "packages/core/src/*")] },
  });
  const checker = program.getTypeChecker();
  const out: Record<string, Set<string>> = {};
  for (const [k, f] of files) {
    const sf = program.getSourceFile(f)!;
    const sym = checker.getSymbolAtLocation(sf);
    out[k] = new Set(sym ? checker.getExportsOfModule(sym).map((e) => e.name) : []);
  }
  return out;
}

const exportsOf = realExports();
for (const sub of ["shell", "chat"] as const) {
  for (const kit of ["react", "native"] as const) {
    const real = [...exportsOf[`${kit}/${sub}`]!].sort();
    const listed = [...T.moved[sub][kit]].sort();
    check(JSON.stringify(real) === JSON.stringify(listed), `moved.${sub}.${kit} is not what ${kit}/${sub} exports:\n  missing from the table: ${real.filter((n) => !listed.includes(n)).join(", ") || "-"}\n  not exported: ${listed.filter((n) => !real.includes(n)).join(", ") || "-"}`);
    for (const n of real) check(!exportsOf[kit]!.has(n), `${kit} root still exports ${n}, which ${sub} also exports`);
  }
}

const anyExport = (n: string) => Object.values(exportsOf).some((s) => s.has(n));
for (const t of T.typeRenames) {
  if (t.from !== "Theme") check(!anyExport(t.from), `typeRenames: ${t.from} is still exported`);
  check(anyExport(t.to), `typeRenames: ${t.to} is not exported by any entry`);
}
for (const r of T.removedNames) check(!anyExport(r.name), `removedNames: ${r.name} is still exported`);

// the docs
const docsModule = (await import(path.join(root, "packages/docs/src/index.ts"))) as { registry: Record<string, { props: Record<string, { options?: (string | number)[] }>; platforms: Record<string, { status: string }> }> };
const registry = docsModule.registry;
const docOf = (comp: string) => registry[kebab(comp)];
const NO_DOCS = new Set(["AntFabricRoot", "AntFabricProvider", "ThemeProvider"]);
const propDocs = (comp: string, label: string) => {
  const d = docOf(comp);
  if (!d && !NO_DOCS.has(comp)) fail(`${label}: ${comp} has no docs`);
  return d?.props;
};
for (const r of T.propRenames) {
  for (const c of r.components) {
    const p = propDocs(c, `propRenames ${r.from} → ${r.to}`);
    if (!p) continue;
    check(r.to in p, `propRenames: ${c}.${r.to} is not a documented prop`);
    if (r.handler !== "ifReadsArg") check(!(r.from in p), `propRenames: ${c}.${r.from} is still a documented prop`);
  }
}
for (const r of T.booleanInversions) {
  for (const c of r.components) {
    const p = propDocs(c, `booleanInversions ${r.from}`);
    if (!p) continue;
    check(r.to in p, `booleanInversions: ${c}.${r.to} is not a documented prop`);
    check(!(r.from in p), `booleanInversions: ${c}.${r.from} is still a documented prop`);
  }
}
for (const r of T.valueRenames) {
  for (const c of r.components) {
    const p = propDocs(c, `valueRenames ${r.prop}=${r.from}`);
    if (!p) continue;
    const to = p[r.toProp ?? r.prop];
    check(!!to, `valueRenames: ${c}.${r.toProp ?? r.prop} is not a documented prop`);
    if (!r.toProp && to?.options) check(to.options.includes(r.toValue), `valueRenames: ${c}.${r.prop} has no option "${r.toValue}"`);
    if (!r.toProp && to?.options) check(!to.options.includes(r.from), `valueRenames: ${c}.${r.prop} still has the option "${r.from}"`);
  }
}
for (const r of T.styleKeyRenames) void r; // parts are checked by the recipes in core, not here
for (const r of T.manualProps) {
  for (const c of r.components) {
    const d = docOf(c);
    check(!!d || NO_DOCS.has(c), `manualProps: ${c} has no docs`);
  }
}
for (const r of T.defaultChanges) for (const c of r.components) check(!!docOf(c), `defaultChanges: ${c} has no docs`);
for (const r of T.itemFieldRenames) for (const c of r.components) check(!!docOf(c), `itemFieldRenames: ${c} has no docs`);
for (const r of T.contentToChildren) for (const c of r.components) { const p = propDocs(c, "contentToChildren"); if (p) check(!(r.prop in p), `contentToChildren: ${c}.${r.prop} is still documented`); }

// ---------------------------------------------------------------------------------------------------------------------
// coverage: every automatic row fires in the fixtures
// ---------------------------------------------------------------------------------------------------------------------

const fired = new Map<string, Set<string>>();
for (const r of Object.values(results)) for (const [rule, d] of Object.entries(r.details)) fired.set(rule, new Set([...(fired.get(rule) ?? []), ...Object.keys(d)]));
const did = (rule: string, detail: string) => fired.get(rule)?.has(detail) ?? false;
for (const r of T.propRenames) for (const c of r.components) check(did("prop-rename", `${c}.${r.from} → ${r.to}`), `no fixture exercises ${c}.${r.from} → ${r.to} (pnpm migrate:1:test --generate-sweep --update)`);
for (const r of T.booleanInversions) for (const c of r.components) check(did("invert-boolean", `${c}.${r.from} → ${r.to}`), `no fixture exercises ${c}.${r.from} → ${r.to}`);
for (const r of T.itemFieldRenames) for (const c of r.components) check(did("item-field", `${c}.${r.prop}[].${r.from} → ${r.to}`), `no fixture exercises ${c}.${r.prop}[].${r.from} → ${r.to}`);
for (const r of T.styleKeyRenames) for (const c of r.components) check(did("styles-key", `${c}.styles.${r.from} → ${r.to}`), `no fixture exercises ${c}.styles.${r.from} → ${r.to}`);
for (const r of T.typeRenames) check(did("type-rename", `${r.from} → ${r.to}`), `no fixture exercises ${r.from} → ${r.to}`);
for (const r of T.valueRenames) for (const c of r.components) {
  const toAttr = r.toValue === "true" ? (r.toProp ?? r.prop) : `${r.toProp ?? r.prop}="${r.toValue}"`;
  check(did("value-rename", `${c}.${r.prop}="${r.from}" → ${toAttr}`), `no fixture exercises ${c}.${r.prop}="${r.from}" → ${toAttr}`);
}
for (const rule of ["content-children", "root-scheme", "root-brand", "theme-line", "invert-boolean", "item-key", "strings-placeholder", "subpath-import", "wrapper-subpath", "wrapper-core-export", "add-attribute"]) {
  check((fired.get(rule)?.size ?? 0) > 0, `no fixture exercises the rule ${rule}`);
}
for (const c of ["Card", "Dialog", "BottomSheet"]) check(did("content-children", `${c}.content → children`), `no fixture exercises ${c}.content → children`);

if (failures.length) {
  console.error(`migrate-1 tests: ${failures.length} failed of ${checks} checks\n`);
  for (const f of failures) console.error("  ✗ " + f);
  process.exit(1);
}
console.log(`migrate-1 tests: ${checks} checks passed${UPDATE ? " (fixtures updated)" : ""}`);

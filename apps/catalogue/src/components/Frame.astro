---
/**
 * The device around a screen. Catalogue chrome only — no kit ships these. The phone
 * frame follows the mobile OS picked in the top bar through CSS, so it never needs
 * re-rendering.
 */
interface Props {
  frame: "browser" | "window" | "phone";
  width?: number;
  height?: number;
  tab?: string;
  url?: string;
  wallpaper?: boolean;
}
const { frame, width, height, tab = "AntFabric", url = "app.antfabric.com", wallpaper = false } = Astro.props;
const size = `${width ? `width:${width}px;` : ""}${height ? `height:${height}px;` : ""}`;
---

{
  frame === "browser" && (
    <div class="frame frame-browser" style={width ? `width:${width}px` : undefined}>
      <div class="bar">
        <div class="lights">
          <i style="background:var(--af-os-mac-close)" />
          <i style="background:var(--af-os-mac-min)" />
          <i style="background:var(--af-os-mac-max)" />
        </div>
        <div class="tab">
          <img src="/brand/antfabric-mark.svg" alt="" />
          <span>{tab}</span>
        </div>
      </div>
      <div class="url">
        <span>{url}</span>
      </div>
      <div style={height ? `height:${height}px;overflow:hidden;display:flex;flex-direction:column` : undefined}>
        <slot />
      </div>
    </div>
  )
}
{
  frame === "window" && (
    <div class="window" style={size + "display:flex;flex-direction:column"}>
      <slot />
    </div>
  )
}
{
  frame === "phone" && (
    <div class:list={["phone", wallpaper && "wallpaper-screen"]}>
      <div class="screen" style={height ? `height:${height}px` : undefined}>
        <div class="island" />
        <div class="status">
          <span>9:41</span>
          <span class="sig">
            <svg class="ios-only" width="18" height="12" viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5.5" width="3" height="6.5" rx="1"/><rect x="10" y="3" width="3" height="9" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1"/></svg>
            <svg class="ios-only" width="26" height="12" viewBox="0 0 26 12" fill="none"><rect x=".5" y=".5" width="22" height="11" rx="3.5" stroke="currentColor" opacity=".4"/><rect x="2" y="2" width="17" height="8" rx="2" fill="currentColor"/><rect x="23.5" y="4" width="1.5" height="4" rx=".75" fill="currentColor" opacity=".4"/></svg>
            <span class="android-only" style="font-size:12px">▾ ▴ 87%</span>
          </span>
        </div>
        <div class="body">
          <slot />
        </div>
        <div class="home">
          <i />
        </div>
      </div>
    </div>
  )
}

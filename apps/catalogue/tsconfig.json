{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "react-native": [
        "../../packages/react-native/node_modules/react-native"
      ]
    }
  }
}
